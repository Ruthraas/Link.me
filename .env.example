# Local: a SQLite file. Production (Vercel): your Turso database URL + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Public URL of the site (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Safe Browsing API key to block phishing/malware links
GOOGLE_SAFE_BROWSING_KEY=

# Optional: set to 1 to skip the Have I Been Pwned password check
DISABLE_PWNED_CHECK=
